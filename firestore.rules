rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@.*'))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email']) &&
             data.userId is string &&
             data.email is string;
    }

    function isValidAnime(data) {
      return data.keys().hasAll(['id', 'title', 'titleAr']) &&
             data.id is string &&
             data.title is string &&
             data.titleAr is string;
    }

    function isValidEpisode(data) {
      return data.keys().hasAll(['id', 'animeId', 'episodeNumber']) &&
             data.id is string &&
             data.animeId is string &&
             data.episodeNumber is number;
    }

    // Users and their subcollections
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidUser(request.resource.data);

      match /watchlist/{animeId} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{animeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Anime catalog
    match /anime/{animeId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isValidAnime(request.resource.data);
      allow delete: if isAuthenticated();

      match /episodes/{episodeId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && isValidEpisode(request.resource.data);
        allow delete: if isAuthenticated();
      }
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
